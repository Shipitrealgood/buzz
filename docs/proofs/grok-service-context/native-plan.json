{
  "status": "PLAN ONLY; actual native service NOT RUN",
  "staging": "/run/buzz-service-proof-DRYRUN",
  "state": [
    "/var/lib/buzz-service-proof-DRYRUN",
    "/var/lib/private/buzz-service-proof-DRYRUN"
  ],
  "unit": "buzz-service-proof-DRYRUN.service",
  "start": [
    "/usr/bin/systemd-run",
    "--unit=buzz-service-proof-DRYRUN.service",
    "--description=buzz-service-proof-DRYRUN",
    "--service-type=oneshot",
    "--property=RemainAfterExit=yes",
    "--property=DynamicUser=yes",
    "--property=StateDirectory=buzz-service-proof-DRYRUN",
    "--property=StateDirectoryMode=0700",
    "--property=RootDirectory=/run/buzz-service-proof-DRYRUN/rootfs",
    "--property=WorkingDirectory=/state",
    "--property=BindPaths=/var/lib/buzz-service-proof-DRYRUN:/state",
    "--property=PrivateNetwork=yes",
    "--property=PrivateTmp=yes",
    "--property=PrivateDevices=yes",
    "--property=MountAPIVFS=yes",
    "--property=ProtectSystem=strict",
    "--property=ProtectHome=yes",
    "--property=ReadWritePaths=/state",
    "--property=NoNewPrivileges=yes",
    "--property=CapabilityBoundingSet=",
    "--property=ProtectProc=invisible",
    "--property=ProtectKernelTunables=yes",
    "--property=ProtectKernelModules=yes",
    "--property=ProtectControlGroups=yes",
    "--property=RestrictNamespaces=yes",
    "--property=RestrictSUIDSGID=yes",
    "--property=RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX",
    "--property=UMask=0077",
    "--property=MemoryMax=1G",
    "--property=TasksMax=128",
    "--property=CPUQuota=100%",
    "--property=LimitCORE=0",
    "--property=LimitNOFILE=128",
    "--property=TimeoutStartSec=20s",
    "--property=TimeoutStopSec=5s",
    "--property=KillMode=control-group",
    "--property=Restart=no",
    "--",
    "/usr/bin/env",
    "-i",
    "HOME=/state/home",
    "GROK_HOME=/state/home/.grok",
    "PATH=/usr/bin:/bin:/runtime",
    "XDG_CONFIG_HOME=/state/home/.config",
    "XDG_RUNTIME_DIR=/run",
    "LANG=C.UTF-8",
    "LC_CTYPE=C.UTF-8",
    "PWD=/state/work",
    "/usr/bin/python3",
    "-S",
    "/proof/context.py",
    "service-proof-agent",
    "native-suite"
  ],
  "restart": [
    "/usr/bin/systemctl",
    "restart",
    "buzz-service-proof-DRYRUN.service"
  ],
  "stop": [
    "/usr/bin/systemctl",
    "stop",
    "buzz-service-proof-DRYRUN.service"
  ],
  "cleanup": "stop owned unit; verify cgroup empty; reset-failed owned unit; remove only listed state and staging",
  "tests": [
    "first-start write/read/models/failure",
    "restart read/models/owner mapping",
    "forced unit exit 70",
    "stopped cgroup empty"
  ],
  "provider_modes": "disabled",
  "network": "PrivateNetwork=yes"
}
