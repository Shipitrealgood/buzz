# REVIEW CANDIDATE ONLY. Never installed by run-proof.py.
# native-proof.py renders a unique transient unit from these properties after approval.
[Unit]
Description=Disposable Buzz service-context proof

[Service]
Type=oneshot
RemainAfterExit=yes
DynamicUser=yes
StateDirectory=buzz-service-proof
StateDirectoryMode=0700
RootDirectory=/var/lib/buzz-service-proof-stage/rootfs
WorkingDirectory=/state
BindPaths=/var/lib/buzz-service-proof:/state
ExecStart=/usr/bin/env -i HOME=/state/home GROK_HOME=/state/home/.grok PATH=/usr/bin:/bin:/runtime XDG_CONFIG_HOME=/state/home/.config XDG_RUNTIME_DIR=/run LANG=C.UTF-8 LC_CTYPE=C.UTF-8 PWD=/state/work /usr/bin/python3 -S /proof/context.py service-proof-agent native-suite
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
MountAPIVFS=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/state
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=1G
TasksMax=128
CPUQuota=100%
LimitCORE=0
LimitNOFILE=128
TimeoutStartSec=20s
TimeoutStopSec=5s
KillMode=control-group
Restart=no
